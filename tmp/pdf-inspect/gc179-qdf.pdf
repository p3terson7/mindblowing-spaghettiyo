function VerifyOTRegTime(Fld1,Fld2,Fld3,Fld4,Fld5,Fld6,Fld7,Fld8,Fld9,Fld10,Fld11,Fld12,Fld13,Fld14,Fld15,Fld16)
{
	var X1 = this.getField(Fld1);
	var X2 = this.getField(Fld2);
        var X3 = this.getField(Fld3);
        var X4 = this.getField(Fld4);
        var X5 = this.getField(Fld5);
        var X6 = this.getField(Fld6);
        var X7 = this.getField(Fld7);
        var X8 = this.getField(Fld8);
        var X9 = this.getField(Fld9);
        var X10 = this.getField(Fld10);
        var X11 = this.getField(Fld11);
        var X12 = this.getField(Fld12);
        var X13 = this.getField(Fld13);
        var X14 = this.getField(Fld14);
        var X15 = this.getField(Fld15);
        var X16 = this.getField(Fld16);
        //var X17 = this.getField(Fld17);

	if ((X1.value == "") && (X2.value == "")&& (X3.value == "")&& (X4.value == "")&& (X5.value == "")&& (X6.value == "")&& (X7.value == "")&& (X8.value == "")&& (X9.value == "")&& (X10.value == "")&& (X11.value == "")&& (X12.value == "")&& (X13.value == "")&& (X14.value == "")&& (X15.value == "")&& (X16.value == ""))

		event.value = ""
	else
		event.value = (Number(X1.value) + Number(X2.value)+ Number(X3.value)+ Number(X4.value)+ Number(X5.value)+ Number(X6.value)+ Number(X7.value)+ Number(X8.value)+ Number(X9.value)+ Number(X10.value)+ Number(X11.value)+ Number(X12.value)+ Number(X13.value)+ Number(X14.value)+ Number(X15.value)+ Number(X16.value))
}





endstream
