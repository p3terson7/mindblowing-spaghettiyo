function SwitchBackgroundColour(){

	var arrLightYellow = ["RGB",1,1,0.667];
	var arrLightBlue = ["RGB",0.667,0.75,1.0];
	var arrLightGrey = ["G",0.925];
	var arrTransparent = color.transparent;

	switch(event.name){
		case "Focus":
			event.target.fillColor = arrLightYellow;
			break;
		case "Blur":
			event.target.fillColor = arrTransparent;
			break;
	}
}











endstream
endobj

