var sCode0 =  "   - Leave Blank - Laisser un blanc";
var sCode1 =  "A - Emergency Situation - Situation d'urgence";
var sCode2 =  "B - Cost Effectiveness - Coût-efficacité";
var sCode3 =  "C - Exceptional Circumstances - Circonstances exceptionnelles";
var sCode4 =  "D - Significant Workload Increases - Augmentation significative de charge de travail";
var sCode5 =  "E - Unanticipated Absence - Absence imprévue";
var sCode6 =  "F - Vacant Position - Poste vacant";
var sCode7 =  "G - Other - Autre";
var cTemp = app.popUpMenu(sCode0, sCode1, sCode2, sCode3, sCode4, sCode5, sCode6, sCode7) ;
this.getField ("OTCODE.1").value = cTemp.substring (0,1) ;
endstream
